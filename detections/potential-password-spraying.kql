// Name:       Potential Password Spraying
// Severity:   Medium
// Frequency:  PT30M   Lookback: PT2H
// Tactics:    CredentialAccess
// Techniques: T1110
// Enabled:    True

// Late-log safe: counts over a 2-hour lookback, then keeps only groups that received new events since the
// last run, so a burst that arrives late still alerts and an old burst does not alert again.
SecurityEvent
| where ingestion_time() <= now()    // rows that arrive after the scheduled time belong to the next run
| where EventID == 4625
| where LogonType in (3, 10)
| summarize StartTime = min(TimeGenerated), EndTime = max(TimeGenerated),
            DistinctAccounts = dcount(TargetUserName), AttemptCount = count(),
            LastIngested = max(ingestion_time()) by IpAddress, bin(TimeGenerated, 30m)
| where DistinctAccounts > 10 and AttemptCount < (DistinctAccounts * 3)   // many accounts, few tries each
| where LastIngested > ago(30m)
| project StartTime, EndTime, IpAddress, DistinctAccounts, AttemptCount
| order by DistinctAccounts desc
