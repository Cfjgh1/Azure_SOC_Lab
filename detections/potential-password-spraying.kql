// Name:       Potential Password Spraying
// Severity:   Medium
// Frequency:  PT5M   Lookback: PT5M
// Tactics:    -
// Techniques: -
// Enabled:    True

SecurityEvent
| where EventID == 4625
| where LogonType in (3, 10)                   
| summarize DistinctAccounts = dcount(TargetUserName), AttemptCount = count() by IpAddress, bin(TimeGenerated, 30m)
| where DistinctAccounts > 10 and AttemptCount < (DistinctAccounts * 3)   
| project TimeGenerated, IpAddress, DistinctAccounts, AttemptCount
| order by TimeGenerated desc
