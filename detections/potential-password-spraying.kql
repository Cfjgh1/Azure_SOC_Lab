// Name:       Potential Password Spraying
// Severity:   Medium
// Frequency:  PT30M   Lookback: PT30M
// Tactics:    CredentialAccess
// Techniques: T1110
// Enabled:    True

SecurityEvent
| where EventID == 4625
| where LogonType in (3, 10)
| summarize StartTime = min(TimeGenerated), EndTime = max(TimeGenerated),
            DistinctAccounts = dcount(TargetUserName), AttemptCount = count() by IpAddress
| where DistinctAccounts > 10 and AttemptCount < (DistinctAccounts * 3)   // many accounts, few tries each
| project StartTime, EndTime, IpAddress, DistinctAccounts, AttemptCount
| order by DistinctAccounts desc
