// Name:       Kerberoasting
// Severity:   Medium
// Frequency:  PT10M   Lookback: PT10M
// Tactics:    CredentialAccess
// Techniques: T1558
// Enabled:    True

SecurityEvent
| where EventID == 4769
| extend TicketEncryptionType = extract('Name="TicketEncryptionType">(.*?)<', 1, EventData)
| extend ServiceName = extract('Name="ServiceName">(.*?)<', 1, EventData)
| extend TargetUserName = extract('Name="TargetUserName">(.*?)<', 1, EventData)
| where TicketEncryptionType == "0x17"           // RC4
| where ServiceName !endswith "$"                // exclude machine accounts (normal RC4 usage)
| where TargetUserName != "ANONYMOUS LOGON"
| summarize StartTime = min(TimeGenerated), EndTime = max(TimeGenerated),
            RequestCount = count(), DistinctServices = dcount(ServiceName) by TargetUserName, Computer
| where RequestCount > 1 or DistinctServices > 1
| project StartTime, EndTime, Computer, TargetUserName, RequestCount, DistinctServices
