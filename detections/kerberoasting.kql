// Name:       Kerberoasting
// Severity:   Medium
// Frequency:  PT5M   Lookback: PT5M
// Tactics:    -
// Techniques: -
// Enabled:    True

SecurityEvent
| where EventID == 4769
| extend TicketEncryptionType = extract('Name="TicketEncryptionType">(.*?)<', 1, EventData)
| extend ServiceName = extract('Name="ServiceName">(.*?)<', 1, EventData)
| extend TargetUserName = extract('Name="TargetUserName">(.*?)<', 1, EventData)
| where TicketEncryptionType == "0x17"         
| where ServiceName !endswith "$"                // exclude machine accounts (normal RC4 usage)
| where TargetUserName != "ANONYMOUS LOGON"
| summarize RequestCount = count(), DistinctServices = dcount(ServiceName) by TargetUserName, Computer, bin(TimeGenerated, 10m)
| where RequestCount > 1 or DistinctServices > 1  
| project TimeGenerated, Computer, TargetUserName, RequestCount, DistinctServices
