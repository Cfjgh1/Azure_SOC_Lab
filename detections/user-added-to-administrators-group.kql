// Name:       User Added to Administrators Group
// Severity:   High
// Frequency:  PT5M   Lookback: PT2H
// Tactics:    PrivilegeEscalation, Persistence
// Techniques: T1098
// Enabled:    True

// Late-log safe: looks back 2 hours but only at events that reached the workspace since the last run,
// so an event that arrives late is still seen once, and one that arrives on time is not alerted twice.
SecurityEvent
| where ingestion_time() > ago(5m)
| where EventID == 4732
| where TargetUserName contains "Administrators"
| project
    TimeGenerated,
    Computer,
    Account,
    MemberName,
    TargetUserName
