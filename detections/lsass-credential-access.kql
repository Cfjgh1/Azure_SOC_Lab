// Name:       LSASS Credential Access
// Severity:   High
// Frequency:  PT5M   Lookback: PT2H
// Tactics:    CredentialAccess
// Techniques: T1003
// Enabled:    True

// Late-log safe: looks back 2 hours but only at events that reached the workspace since the last run,
// so an event that arrives late is still seen once, and one that arrives on time is not alerted twice.
Event
// now() is the run's scheduled time; rows that arrive after it are left for the next run, so nothing alerts twice.
| where ingestion_time() > ago(5m) and ingestion_time() <= now()
| where Source == "Microsoft-Windows-Sysmon" and EventID == 10
| extend TargetImage    = extract('Name="TargetImage">(.*?)<', 1, EventData)
| extend SourceImage    = extract('Name="SourceImage">(.*?)<', 1, EventData)
| extend GrantedAccess  = extract('Name="GrantedAccess">(.*?)<', 1, EventData)
| extend CallTrace      = extract('Name="CallTrace">(.*?)<', 1, EventData)
| where TargetImage endswith "lsass.exe"
| where GrantedAccess in ("0x1010", "0x1410", "0x1438", "0x143a", "0x1fffff") // common dump-capable access masks
| where SourceImage !in (
    @"C:\Windows\System32\svchost.exe",
    @"C:\Windows\System32\wininit.exe",
    @"C:\Program Files\Windows Defender\MsMpEng.exe"
  )
| where not(SourceImage startswith @"C:\ProgramData\Microsoft\Windows Defender\Platform\" and SourceImage endswith @"\MsMpEng.exe") // Defender after updates
| project TimeGenerated, Computer, SourceImage, TargetImage, GrantedAccess, CallTrace
