// Name:       LSASS Credential Access
// Severity:   High
// Frequency:  PT5M   Lookback: PT5M
// Tactics:    CredentialAccess
// Techniques: T1003
// Enabled:    True

Event
| where Source == "Microsoft-Windows-Sysmon" and EventID == 10
| extend TargetImage    = extract('Name="TargetImage">(.*?)<', 1, EventData)
| extend SourceImage    = extract('Name="SourceImage">(.*?)<', 1, EventData)
| extend GrantedAccess  = extract('Name="GrantedAccess">(.*?)<', 1, EventData)
| extend CallTrace      = extract('Name="CallTrace">(.*?)<', 1, EventData)
| where TargetImage endswith "lsass.exe"
| where GrantedAccess in ("0x1010", "0x1410", "0x1438", "0x1438", "0x143a", "0x1fffff") // common dump-capable access masks
| where SourceImage !in (
    @"C:\Windows\System32\svchost.exe",
    @"C:\Windows\System32\wininit.exe",
    @"C:\Program Files\Windows Defender\MsMpEng.exe"
  )  
| project TimeGenerated, Computer, SourceImage, TargetImage, GrantedAccess, CallTrace
