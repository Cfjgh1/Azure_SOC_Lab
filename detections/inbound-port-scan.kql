// Name:       Inbound Port Scan
// Severity:   Medium
// Frequency:  PT5M   Lookback: PT2H
// Tactics:    Discovery
// Techniques: T1046
// Enabled:    True

// Uses Windows Firewall's blocked-traffic events. Sysmon cannot see this activity: a scanned port with nothing
// listening produces no connection, so a 1000-port scan left only 2 Sysmon events in testing.
// Late-log safe: counts over a 2-hour lookback, then keeps only groups that received new events since the
// last run, so a burst that arrives late still alerts and an old burst does not alert again.
SecurityEvent
| where EventID in (5152, 5157)                  // packet or connection blocked
| extend Direction       = extract('Name="Direction">(.*?)<', 1, EventData)
| extend SourceIp        = extract('Name="SourceAddress">(.*?)<', 1, EventData)
| extend DestinationPort = extract('Name="DestPort">(.*?)<', 1, EventData)
| where Direction == "%%14592"                   // inbound
| summarize ConnectionCount = count(), DistinctPorts = dcount(DestinationPort),
            LastIngested = max(ingestion_time()) by Computer, SourceIp, bin(TimeGenerated, 5m)
| where ConnectionCount > 100 and DistinctPorts > 20
| where LastIngested > ago(5m)
| project TimeGenerated, Computer, SourceIp, ConnectionCount, DistinctPorts
