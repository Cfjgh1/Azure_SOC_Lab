// Name:       Inbound Port Scan
// Severity:   Medium
// Frequency:  PT5M   Lookback: PT5M
// Tactics:    Discovery
// Techniques: T1046
// Enabled:    True

// Uses Windows Firewall's blocked-traffic events. Sysmon can't see this activity: a scanned port with nothing
// listening produces no connection, so a 1000-port scan left only 2 Sysmon events in testing.
SecurityEvent
| where EventID in (5152, 5157)                  // packet or connection blocked
| extend Direction       = extract('Name="Direction">(.*?)<', 1, EventData)
| extend SourceIp        = extract('Name="SourceAddress">(.*?)<', 1, EventData)
| extend DestinationPort = extract('Name="DestPort">(.*?)<', 1, EventData)
| where Direction == "%%14592"                   // inbound
| summarize ConnectionCount = count(), DistinctPorts = dcount(DestinationPort) by Computer, SourceIp, bin(TimeGenerated, 5m)
| where ConnectionCount > 100 and DistinctPorts > 20
| project TimeGenerated, Computer, SourceIp, ConnectionCount, DistinctPorts
