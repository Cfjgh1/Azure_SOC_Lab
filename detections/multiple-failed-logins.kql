// Name:       Multiple Failed Logins
// Severity:   Medium
// Frequency:  PT5M   Lookback: PT2H
// Tactics:    CredentialAccess
// Techniques: T1110
// Enabled:    True

// Late-log safe: counts over a 2-hour lookback, then keeps only groups that received new events since the
// last run, so a burst that arrives late still alerts and an old burst does not alert again.
// Windows are 10 minutes long and start every 5 minutes, so a burst cannot be split across a bin boundary.
SecurityEvent
| where ingestion_time() <= now()    // rows that arrive after the scheduled time belong to the next run
| where EventID == 4625
| extend Ingested = ingestion_time()
| extend WindowStart = range(bin(TimeGenerated, 5m) - 5m, bin(TimeGenerated, 5m), 5m)
| mv-expand WindowStart to typeof(datetime)
| summarize FailedAttempts = count(), FirstAttempt = min(TimeGenerated), LastAttempt = max(TimeGenerated),
            LastIngested = max(Ingested) by Account, Computer, IpAddress, WindowStart
| where FailedAttempts >= 5
| summarize arg_max(FailedAttempts, *) by Account, Computer, IpAddress      // one row per source: its worst window
| where LastIngested > ago(5m)
| project TimeGenerated = FirstAttempt, Account, Computer, IpAddress, FailedAttempts, FirstAttempt, LastAttempt
