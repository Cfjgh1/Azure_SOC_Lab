// Name:       Scheduled Task Persistence
// Severity:   High
// Frequency:  PT5M   Lookback: PT2H
// Tactics:    Persistence
// Techniques: T1053
// Enabled:    True

// Late-log safe: looks back 2 hours but only at events that reached the workspace since the last run,
// so an event that arrives late is still seen once, and one that arrives on time is not alerted twice.
SecurityEvent
// now() is the run's scheduled time; rows that arrive after it are left for the next run, so nothing alerts twice.
| where ingestion_time() > ago(5m) and ingestion_time() <= now()
| where EventID == 4698
| extend TaskName    = extract('Name="TaskName">(.*?)<', 1, EventData)
| extend TaskContent = extract('Name="TaskContent">(.*?)<', 1, EventData)
| where TaskContent has_any ("powershell", "cmd.exe", "rundll32", "regsvr32", "mshta", "\\Users\\Public", "\\Temp\\")
| project TimeGenerated, Computer, SubjectUserName, TaskName, TaskContent
| order by TimeGenerated desc
